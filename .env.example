# Required. Create a dedicated read-only Virtuous user and API key.
# Settings, Connectivity, API Keys. Never commit a real key.
VIRTUOUS_API_KEY=

# Optional. Trailing slash required by virtuous-ts.
VIRTUOUS_BASE_URL=https://api.virtuoussoftware.com/api/

# Hard cap for query_gifts and query_contacts (queryAll).
VIRTUOUS_MAX_RECORDS=10000

# Refuse a call when X-RateLimit-Remaining is at or below this.
# The org shares 5,000 requests per hour. Leave headroom for other apps.
VIRTUOUS_RATE_RESERVE=50

# Parsed in v0.1, but write tools are not registered either way.
# v0.2 will honor true. Leave this false.
VIRTUOUS_ALLOW_WRITES=false
