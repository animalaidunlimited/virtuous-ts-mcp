{
  "name": "virtuous-ts-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for Virtuous CRM+, built on virtuous-ts. Contacts, gifts, and campaigns for Claude, Cursor, and other MCP hosts.",
  "type": "module",
  "bin": {
    "virtuous-ts-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:live": "vitest run tests/live.test.ts",
    "start": "node dist/index.js",
    "inspector": "npx --yes @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "virtuous",
    "crm",
    "model-context-protocol"
  ],
  "author": "Spencer Hardy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/animalaidunlimited/virtuous-ts-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "virtuous-ts": "file:../virtuous-ts-v1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
